{
  "name": "secret-santa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:storybook": "vitest run --project storybook",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:storybook && npm run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.64.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-storybook": "^10.6.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "latest",
    "prettier": "^3.9.9",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "latest",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
